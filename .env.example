# ── Core runtime ──────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/ai_client_acquisition
JWT_SECRET=change-me-long-random-string
PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# ── Auth (current Manus-compatible OAuth; replace when migrating auth) ─────
OAUTH_SERVER_URL=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# ── AI (Groq) — server-only, never exposed to the browser ─────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── Lead discovery (ScrapeGraphAI) — server-only ───────────────────────────
SGAI_API_KEY=
RESEARCH_CACHE_HOURS=72
AI_CACHE_HOURS=24

# ── Billing (Platega) — server-only ─────────────────────────────────────────
# Issued by your Platega manager; also in the merchant cabinet → Settings.
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_API_URL=https://app.platega.io/
# Explicit provider override: "platega" | "mock". Default: platega when both
# credentials are set, otherwise mock (development only, no real charges).
BILLING_PROVIDER=
# Shared token required on mock webhook callbacks (dev only).
MOCK_BILLING_WEBHOOK_SECRET=mock
# Plan pricing in integer minor units (cents) — optional overrides.
BILLING_PRICE_STARTER=2900
BILLING_PRICE_PRO=7900
BILLING_PRICE_AGENCY=19900
BILLING_CURRENCY=USD
