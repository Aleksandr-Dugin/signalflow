# ── Core runtime ──────────────────────────────────────────────────────────
# DATABASE_URL is REQUIRED for the app to persist anything. Without it the
# server boots but every DB route fails soft (no fake writes).
DATABASE_URL=mysql://user:password@localhost:3306/signalflow
# JWT_SECRET is REQUIRED. The server will refuse to start auth without it.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Set to true when running behind an HTTPS reverse proxy (load balancer,
# nginx, Fly/Render, etc.). Enables Secure cookies and correct protocol.
TRUST_PROXY=false

# ── Email/password auth ───────────────────────────────────────────────────
# (uses the local users table; no external provider needed)

# ── Google OAuth (server-side code exchange) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub OAuth ──────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── AI (Groq) — server-only, never exposed to the browser ─────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_CACHE_HOURS=24
RESEARCH_CACHE_HOURS=72

# ── Lead discovery (ScrapeGraphAI) — server-only ──────────────────────────
SGAI_API_KEY=
# How many companies per discovery run get a second pass over their own
# /contact|/team|/about pages to find a published address. Each company costs
# scraper credits and the pass stops early once a named person is found, so this
# is a budget cap, not a target. 0 = manual contacts only (all else still works).
MAX_CONTACT_ENRICHMENTS=10

# ── Paid enrichment (optional) — server-only; buys what scraping cannot find ─
# Named decision-maker, direct address, phone, social profile. Leave
# ENRICHMENT_PROVIDER empty and nothing is ever bought: a key alone is not
# enough, because spending money should be a decision, not a side effect.
# hunter = per company, one call, observed addresses. apollo = per person,
# 1-9 credits each, richer (title/phone/linkedin).
ENRICHMENT_PROVIDER=
HUNTER_API_KEY=
APOLLO_API_KEY=
# People looked up per prospect, per lookup. Spend cap, not a target.
ENRICHMENT_MAX_PEOPLE=5
# Requires ENRICHMENT_PROVIDER as well: lets an unattended discovery run buy
# contacts for companies whose own pages named nobody (capped by
# MAX_CONTACT_ENRICHMENTS per run). Off means the autopilot never spends money.
ENRICHMENT_AUTO_DISCOVER=false

# ── Outbound email (SMTP) — server-only; enables real outreach sends ───────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SignalFlow <no-reply@example.com>"
# A mailbox that can actually receive replies. Also supplies the mailto leg of
# the RFC 8058 List-Unsubscribe header; strongly recommended for deliverability.
SMTP_REPLY_TO=
# Physical postal address of the sender, required by CAN-SPAM (and Art 13/14 GDPR
# for EU recipients). It is appended to the compliance footer of every outbound
# message; unset means the footer carries the unsubscribe line and a link to
# /privacy but no postal address — a production boot warns you about it.
SENDER_POSTAL_ADDRESS=

# Shared secret required on the inbound-reply webhook. Unset => webhook 503.
REPLY_INGEST_SECRET=

# ── Non-email channels (Telegram / WhatsApp) — server-only ─────────────────
# Neither platform allows cold outreach, so these do not buy reach: they let a
# person who chose to write to us be answered there. The flow is
# email -> t.me/<bot>?start=<ref> -> their /start event -> a consent row -> sends.
# Leave everything below empty and the channels simply do not exist.
TELEGRAM_BOT_TOKEN=
# Public username without the @. Builds the deep link and the tracked CTA target.
TELEGRAM_BOT_USERNAME=
# Any long random string. Registered with setWebhook and required on every inbound
# call as X-Telegram-Bot-Api-Secret-Token; unset => /api/channels/telegram 503.
# Register it yourself once the app is on a public HTTPS origin:
#   curl -F access_token=$TELEGRAM_BOT_TOKEN -F url=https://<host>/api/channels/telegram \
#        -F secret_token=$TELEGRAM_WEBHOOK_SECRET \
#        https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Cloud API. Free-form text is only permitted inside the 24 h window the
# recipient opened by messaging the business; this software never sends templates.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta's app secret: signs each webhook body (X-Hub-Signature-256). Unset => 503.
WHATSAPP_APP_SECRET=
# Only used to answer the one-time subscription handshake (hub.verify_token).
WHATSAPP_VERIFY_TOKEN=
# Shorten the reply window if you like. Values above 24 are ignored: that is the
# platform's limit, and this setting cannot buy a longer one than WhatsApp allows.
MESSENGER_WINDOW_HOURS=24

# ── Billing (Platega) — server-only ───────────────────────────────────────
# Issued by your Platega manager; also in the merchant cabinet -> Settings.
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_API_URL=https://app.platega.io/
# Explicit provider override: "platega" | "mock". If unset: platega when both
# credentials are present, otherwise mock. In production, mock is refused.
BILLING_PROVIDER=
MOCK_BILLING_WEBHOOK_SECRET=
# Plan pricing in integer minor units (cents) — optional overrides.
BILLING_PRICE_STARTER=2900
BILLING_PRICE_PRO=7900
BILLING_PRICE_AGENCY=19900
BILLING_CURRENCY=USD

# ── Autonomous AI-SDR layer (docs/ai-agents.md) ───────────────────────
# When these are set the AI follow-up writer embeds them into the CTA, and the
# send pipeline rewrites them into per-message tracked links.
CALENDLY_URL=
STRIPE_PAYMENT_LINK=
# Signing secrets for the callbacks that move a deal to meeting_booked / won.
# Point the provider webhook at POST /api/conversions/calendly and
# /api/conversions/stripe. While a secret is UNSET that endpoint answers 503 to
# everything, so a half-configured deployment cannot be spoofed into fake deals.
CALENDLY_SIGNING_SECRET=
STRIPE_WEBHOOK_SECRET=
# Discovery re-check cadence in hours. 0 disables the recurring job. Any
# positive value turns the queue worker into a lightweight cron.
DISCOVERY_INTERVAL_HOURS=0
# Native ESP inbound webhooks. Each authenticates with REPLY_INGEST_SECRET above,
# but not every provider can carry it the same way — read the right line:
#   POST /api/replies/webhook/mailgun     HMAC of timestamp+token (signature field)
#   POST /api/replies/webhook/sendgrid    basic auth, secret as the password
#   POST /api/replies/webhook/postmark    X-Postmark-Secret header
#   POST /api/replies/webhook/ses         ?key=<secret> on the SNS subscription URL
# For SES the credential rides in the URL because SNS cannot send an HMAC of our
# choosing; that proves possession of the secret, not that Amazon sent the request.
# Verifying the SNS certificate signature is still outstanding.
# Per-workspace autopilot is toggled in the app Settings page.
